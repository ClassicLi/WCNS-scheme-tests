&complex_wave_nml
  mesh_num = 200
  periods = 4
  cfl = 0.3d0
  output_dir = 'results'
/
&scheme_nml
  scheme = 'Z5'
  js3_eps = 1.0d-6, js3_p = 2.0d0
  z3_eps = 1.0d-40, z3_q = 2.0d0
  js5_eps = 1.0d-6, js5_p = 2.0d0
  z5_eps = 1.0d-40, z5_q = 2.0d0
  qr_smv = 1.0d-80
  rbf_size = 5, rbf_kernel = 'GA', rbf_num_deriv = 'right', rbf_denom_deriv = 'right', rbf_floor_value = 30.0d0
  moc322_eps = 1.0d-80, moc322_M_q = 2
  moc33_eps = 1.0d-80, moc33_p = 2, moc33_linear = 'GA'
  moc53_eps = 1.0d-80, moc53_N_q = 4, moc53_p = 2, moc53_linear = 'LINEAR'
  moz_eps = 1.0d-80, moz_N_q = 4, moz_M_q = 2
/
&difference_nml
  difference_operator = 'HCS6'
/
